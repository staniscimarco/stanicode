{
  "name": "stanicode",
  "version": "0.1.0-dev",
  "private": true,
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "test": "python3 -m unittest discover -s tests -v",
    "desktop": "cd apps/desktop && tauri",
    "check": "tsc --noEmit",
    "test:ui": "vitest run",
    "format": "prettier --write apps/desktop/src package.json tsconfig.json vitest.config.ts tests/ui.test.tsx"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
