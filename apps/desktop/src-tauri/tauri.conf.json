{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STANICODE",
  "version": "0.1.0",
  "identifier": "app.stanicode.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "STANICODE",
        "width": 1250,
        "height": 850,
        "minWidth": 850,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../.local/package/": "payload/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Italian"
        ],
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
